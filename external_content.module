<?php

/**
 * @file
 * External Content module.
 *
 * Hooks are implemented as classes in src/Hook/ExternalContentHooks.php.
 */

/**
 * Implements hook_theme().
 *
 * Remove on upgrade to D11.
 */
function external_content_theme(): array {
  // Drupal 11+ discovers class-based hooks via #[Hook] attributes.
  if (class_exists('Drupal\\Core\\Hook\\Attribute\\Hook')) {
    return [];
  }

  return (new \Drupal\external_content\Hook\ExternalContentHooks())->theme();
}

/**
 * Implements hook_theme_suggestions_HOOK().
 *
 * Remove on upgrade to D11.
 */
function external_content_theme_suggestions_external_content(
  array $variables,
): array {
  // Drupal 11+ discovers class-based hooks via #[Hook] attributes.
  if (class_exists('Drupal\\Core\\Hook\\Attribute\\Hook')) {
    return [];
  }

  return (new \Drupal\external_content\Hook\ExternalContentHooks())
    ->themeSuggestionsExternalContent($variables);
}

/**
 * Implements hook_preprocess_HOOK().
 */
function external_content_preprocess_external_content(array &$variables): void {
  // Drupal 11+ discovers class-based hooks via #[Hook] attributes.
  if (class_exists('Drupal\\Core\\Hook\\Attribute\\Hook')) {
    return;
  }

  (new \Drupal\external_content\Hook\ExternalContentHooks())
    ->preprocessExternalContent($variables);
}

